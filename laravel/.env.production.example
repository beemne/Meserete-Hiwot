# =====================================================================
# MEZMUR ZEMSERETEE HIWOT — PRODUCTION ENVIRONMENT CONFIGURATION
# Optimized for cPanel / Shared Hosting / LiteSpeed / Nginx / Apache
# =====================================================================

APP_NAME="Mezmur Zemseretee Hiwot"
APP_ENV=production
APP_KEY=base64:z8B6Cybu5XqYTYb8OeFAqL3partPoHqpPxxa2F8nqoI=
APP_DEBUG=false
APP_URL=https://api.mh.hersolan.pro

# Sensitive Column Encryption (Generate with: php artisan mz:encrypt-data --generate-key)
DATA_ENCRYPTION=true
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_OLD_KEYS=

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------
# Database (cPanel MySQL / MariaDB)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_mezmur_prod
DB_USERNAME=cpaneluser_mz_admin
DB_PASSWORD="your_strong_mysql_password_here"

# ---------------------------------------------------------------------
# Session, Cache & Queue (Shared Hosting Compatible)
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Security & CORS
# ---------------------------------------------------------------------
CORS_ORIGINS=https://mh.hersolan.pro,https://api.mh.hersolan.pro

# ---------------------------------------------------------------------
# Mail Delivery (SMTP via cPanel Webmail or external SMTP)
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.mh.hersolan.pro
MAIL_PORT=465
MAIL_USERNAME=noreply@mh.hersolan.pro
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@mh.hersolan.pro"
MAIL_FROM_NAME="መሠረተ ሕይወት"

# ---------------------------------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# ---------------------------------------------------------------------
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

# ---------------------------------------------------------------------
# Telegram Bot (Optional)
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
