<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds shrink unused resources. audio_service looks its media-button icons up by
     name at run time (drawable/audio_service_*), so the shrinker cannot see they are used and
     removed them: the play / pause / next / previous notification then failed to build
     ("You must specify an icon resource id to build a CustomAction") and no controls appeared. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher,@drawable/ic_stat_*" />
